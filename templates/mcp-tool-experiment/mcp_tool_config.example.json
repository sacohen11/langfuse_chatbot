{
  "participant_name": "your-name",
  "experiment_name": "hosted-mcp-tool-spec",
  "prompt_name": "team/hosted-mcp-tool-spec",
  "dataset_name": "team/hosted-mcp-tool-eval",
  "task_model": "gpt-5.4",
  "judge_model": "gpt-4.1-mini",
  "candidate_tool_spec_file": "tool_candidate.json",
  "attempt_log_file": "tool_attempts.jsonl",
  "leaderboard_path": "leaderboard.csv",
  "server": {
    "name": "hosted-mcp-server",
    "environment": "dev",
    "platform": "rancher-kubernetes",
    "cluster": "rancher-cluster-name",
    "namespace": "mcp-tools",
    "workload": "hosted-mcp-server",
    "transport": "http",
    "mcp_url": "https://mcp-server.example.com/mcp",
    "schema_url": "https://mcp-server.example.com/.well-known/mcp-tool-schema.json",
    "schema_file": "",
    "schema_json_path": "",
    "health_url": "https://mcp-server.example.com/healthz",
    "tls_verify": true,
    "headers": {
      "Authorization": "Bearer ${MCP_SERVER_TOKEN:-}"
    }
  },
  "scores": [
    {
      "name": "invocation_accuracy",
      "type": "llm_judge",
      "rubric": "Does the model choose whether to call the right MCP tool and provide correct, minimal arguments?"
    },
    {
      "name": "input_schema_quality",
      "type": "llm_judge",
      "rubric": "Do the input schemas make required fields, argument boundaries, and forbidden extras clear?"
    },
    {
      "name": "output_schema_quality",
      "type": "llm_judge",
      "rubric": "Do the output schemas include the fields needed for useful downstream assistant responses?"
    },
    {
      "name": "description_clarity",
      "type": "llm_judge",
      "rubric": "Are the tool descriptions specific, concise, and clear about when to use or not use each tool?"
    },
    {
      "name": "conciseness",
      "type": "managed_langfuse",
      "evaluator_name": "Conciseness",
      "variable_map": {
        "query": "input.user_request",
        "generation": "output"
      }
    }
  ]
}
