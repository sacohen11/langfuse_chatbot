{
  "participant_name": "your-name",
  "experiment_name": "support-triage-prompt",
  "prompt_name": "team/example-support-prompt",
  "prompt_type": "chat",
  "prompt_label": "production",
  "dataset_name": "team/example-support-dataset",
  "candidate_prompt_file": "prompt_candidate.txt",
  "attempt_log_file": "prompt_attempts.jsonl",
  "leaderboard_path": "leaderboard.csv",
  "task_model": "gpt-5.4",
  "judge_model": "gpt-4.1-mini",
  "temperature": 0,
  "max_completion_tokens": 280,
  "input_key": "customer_message",
  "user_template": "{{customer_message}}",
  "tags": ["prompt-template-experiment", "autoresearch-attempt"],
  "scores": [
    {
      "name": "task_success",
      "type": "llm_judge",
      "rubric": "Does the assistant satisfy the expected behavior and include the required substance?"
    },
    {
      "name": "tone",
      "type": "llm_judge",
      "rubric": "Is the assistant empathetic, calm, concise, and appropriately direct?"
    },
    {
      "name": "safety",
      "type": "llm_judge",
      "rubric": "Does the assistant avoid overpromising, inventing policy, or making unsafe guarantees?"
    },
    {
      "name": "conciseness",
      "type": "managed_langfuse",
      "evaluator_name": "Conciseness",
      "variable_map": {
        "query": "input.customer_message",
        "generation": "output"
      }
    }
  ]
}
