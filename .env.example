# LLM provider. LangChain model strings support provider prefixes, e.g. openai:gpt-4.1-mini.
OPENAI_API_KEY=
CHATBOT_MODEL=openai:gpt-4.1-mini
CHATBOT_TEMPERATURE=0

# Langfuse v3 SDK. Leave empty for local-only tests/evals.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST is also supported for compatibility with Langfuse examples.
LANGFUSE_HOST=https://cloud.langfuse.com

# Deployed LangGraph eval endpoint. Usually reached through kubectl port-forward:
# kubectl -n <namespace> port-forward svc/<langgraph-service-name> 8080:80
LANGGRAPH_EVAL_URL=http://localhost:8080/internal/eval/run
LANGGRAPH_EVAL_TIMEOUT=120

# Autoresearch prompt optimization workspace.
AUTORESEARCH_CANDIDATES=3
AUTORESEARCH_WORKSPACE_DIR=autoresearch

# Example auth token for an HTTPS MCP server you own.
MY_MCP_TOKEN=
